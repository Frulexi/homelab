# Copy this file to ".env" and fill in real values. Do not commit actual .env files.
# Generate APP_KEY with: docker compose run --rm app php artisan key:generate --show

# Application
APP_KEY=
APP_URL=https://snipeit.prod.landingsnet.com
APP_TIMEZONE=America/New_York
APP_LOCALE=en
APP_ENV=production
APP_DEBUG=false
APP_TRUSTED_PROXIES=*

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=snipeit
DB_USERNAME=snipeit
DB_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# Mail (optional)
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDR=snipeit@example.com
# MAIL_FROM_NAME=Snipe-IT
