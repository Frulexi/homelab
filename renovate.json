{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":dependencyDashboard"
  ],

  "timezone": "America/New_York",
  "internalChecksAsSuccess": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "dependencyDashboardApproval": false,

  "automerge": true,
  "automergeType": "pr",
  "labels": ["dependencies", "renovate"],

  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dependency Dashboard",

  "packageRules": [
    {
      "description": "Automerge minor, patch, and digest updates for non-databases",
      "matchUpdateTypes": ["minor", "patch", "pinDigest", "digest"],
      "excludePackagePatterns": ["postgres", "mongo", "mysql", "redis"],
      "automerge": true
    },
    {
      "description": "Pin digests for any container using the :latest tag",
      "matchDatasources": ["docker"],
      "matchCurrentValue": "latest",
      "pinDigests": true,
      "automerge": true
    },
    {
      "description": "EXCLUDE: Local custom images",
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["^apple-trans$", "^landing_sales$", "^landingsales$"],
      "enabled": false
    },
    {
      "description": "EXCLUDE: Twingate for stability",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["twingate/connector"],
      "enabled": false
    },
    {
      "description": "GROUP: Grafana monitoring stack",
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["^grafana/"],
      "groupName": "Grafana Stack"
    },
    {
      "description": "GROUP: Authentik identity services",
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["goauthentik/"],
      "groupName": "Authentik"
    },
    {
      "description": "GROUP: Home automation",
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["home-assistant/", "esphome/"],
      "groupName": "Home Automation"
    },
    {
      "description": "GROUP: Traefik proxy stack",
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["^traefik$", "^sablierapp/"],
      "groupName": "Traefik Proxy",
      "fetchChangeLogs": "off"
    },
    {
      "description": "Actualbudget uses :latest (no semver tags available) - pin digest",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["actualbudget/actual-server"],
      "pinDigests": true,
      "automerge": true
    },
    {
      "description": "Database images require manual review",
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["postgres", "mongo", "mysql", "redis"],
      "automerge": false,
      "labels": ["dependencies", "database", "requires-review"]
    },
    {
      "description": "FORCE: Override Mend's global dashboard approval policy",
      "matchPackageNames": ["*"],
      "dependencyDashboardApproval": false
    }
  ],

  "docker-compose": {
    "fileMatch": ["services/.+/docker-compose\\.ya?ml$"]
  }
}
